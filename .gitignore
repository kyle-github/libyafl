# Build directories and artifacts
/build/
/cmake-build-*/
*.o
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Debug symbols
*.dSYM/
*.pdb

# Test executables
/test_fcontext_basic
/test_fcontext_simple
/test_fcontext_transfer

# IDE and editor files
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~
*.orig

# CMake generated files (not to be checked in)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
/Makefile
a.out

# CTest and test runtime artifacts
Testing/

# Python bytecode (if any)
__pycache__/
*.pyc
